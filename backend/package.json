{
  "name": "backend",
  "version": "1.0.0",
  "description": "Legacy Migration Backend",
  "main": "config/server.js",
  "scripts": {
    "start": "node config/server.js",
    "dev": "nodemon",
    "init-db": "node scripts/init-db.js",
    "migrate": "node scripts/apply-migrations.js",
    "env:local": "node -e \"require('fs').copyFileSync('.env.local','.env'); console.log('OK: .env waxaa laga soo qaaday .env.local (PostgreSQL local)')\"",
    "env:remote": "node -e \"require('fs').copyFileSync('.env.remote-192','.env'); console.log('OK: .env waxaa laga soo qaaday .env.remote-192 (PostgreSQL Webmin 192)')\"",
    "my-ip": "node scripts/show-my-ip.js"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.0",
    "pg-query-stream": "^4.12.0"
  }
}
