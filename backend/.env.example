# ============== Node ==============
NODE_ENV=development
PORT=3030

# CORS: when frontend is on http://localhost:5173 and backend on 192.x.x.x:3030, allow that origin
# (comma-separated; leave empty to use defaults: localhost:5173, 192.145.173.81, etc.)
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ============== Auth (JWT session cookie) ==============
# Random string ≥ 32 chars. PRODUCTION-ka waa LAGAMA-MAARMAAN — server-ku
# ma kici doono haddii uusan jirin oo NODE_ENV=production. Dev-ka haddii
# uusan jirin, fallback ayaa la isticmaalayaa (warning ayaa la muujinayaa).
#
# Soo abuur si amaan ah:
#   Linux/Mac:   openssl rand -base64 48
#   PowerShell:  [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#   Node:        node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-random-48-byte-base64-string-not-this

# ============== PostgreSQL (database-ka cusub – pgAdmin 192.145.173.81) ==============
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=3335
DB_NAME=syddbtest

# DATABASE_URL: furaha iyo user-ka waa in la encode-gareeaa (URL encoding).
# Sababta: @ iyo # ee password-ka/email-ka URL-ka way jebinayaan.
# Encode: @ -> %40    # -> %23    ! -> %21
#
# Tusaale haddii DB_PASSWORD = syd@2018#2026!
#   encoded = syd%402018%232026!
# Tusaale haddii DB_USER = sydcompany2018@gmail.com
#   encoded = sydcompany2018%40gmail.com
#
# Halkan geli string-ka dhan (user encoded : password encoded @ host : port / dbname)
DATABASE_URL=postgres://USER_ENCODED:PASSWORD_ENCODED@DB_HOST:DB_PORT/DB_NAME
